<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />
        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
        <variable
            name="controlador"
            type="es.davante.edadcanina.controlador.EdadCaninaControlador" />
    </data>
<androidx.appcompat.widget.LinearLayoutCompat
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">



<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="32dp"
    android:gravity="center"
    android:text="@string/txt_titulo"
    android:textSize="32sp">
</TextView>

    <ImageView
        android:layout_width="192dp"
        android:layout_height="wrap_content"
        android:src="@drawable/imgdog"
        android:adjustViewBounds="true"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/input_age"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="48sp"
        android:hint="@string/hint_edad"
        android:id="@+id/age_input"
        android:inputType="number"
        android:maxLength="2"
        android:gravity="center"
        android:importantForAutofill="no"
        android:text="@={modelo.edadTexto}"
        app:errorValidacion="@{modelo.validacion}"
        />

 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:textSize="16sp"
     android:gravity="center"
     android:layout_marginTop="20dp"
     android:id="@+id/result_text"
     android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
     android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}"
     />

    <!-- Coloco Calcular y Limpiar en paralelo con el mismo peso para aprovechar el ancho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_calc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:onClick="@{() -> controlador.onCalcularClick()}"
            android:text="@string/btn_calc"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_limpiar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:onClick="@{() -> controlador.onLimpiarClick()}"
            android:text="@string/btn_limpiar"
            android:textSize="20sp" />

    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
</layout>